  "components": {
    "schemas": {
      "AttachmentInput": {
        "properties": {
          "conversation_id": {
            "type": "string",
            "maxLength": 36,
            "minLength": 36,
            "title": "Conversation Id"
          },
          "name": {
            "type": "string",
            "maxLength": 160,
            "minLength": 1,
            "title": "Name"
          },
          "data_base64": {
            "type": "string",
            "maxLength": 11200000,
            "minLength": 1,
            "title": "Data Base64"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "conversation_id",
          "name",
          "data_base64"
        ],
        "title": "AttachmentInput"
      },
      "ChatInput": {
        "properties": {
          "conversation_id": {
            "type": "string",
            "maxLength": 36,
            "minLength": 36,
            "title": "Conversation Id"
          },
          "message": {
            "type": "string",
            "maxLength": 8000,
            "minLength": 1,
            "title": "Message"
          },
          "request_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 8,
            "title": "Request Id"
          },
          "stream": {
            "type": "boolean",
            "title": "Stream",
            "default": false
          },
          "max_tokens": {
            "type": "integer",
            "maximum": 3072.0,
            "minimum": 32.0,
            "title": "Max Tokens",
            "default": 512
          },
          "attachment_ids": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array",
                "maxItems": 4
              },
              {
